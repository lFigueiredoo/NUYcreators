# No secrets belong in NEXT_PUBLIC variables. Use a dedicated NUY Creators project.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
# Approved NUY Creators ID. Must be supplied independently; never auto-populated.
APPWRITE_EXPECTED_PROJECT_ID=
APPWRITE_DATABASE_ID=nuy-creators
APPWRITE_ADMIN_TEAM_ID=nuy-admins
# Provisioning only. Never required by the public web application.
APPWRITE_API_KEY=
# Web server only: a SEPARATE key scoped exclusively to sessions.write.
APPWRITE_AUTH_API_KEY=
# Server only: a SEPARATE key scoped to rows.read + rows.write. This is the write
# path for the operational core (join, submit, moderation, points, redeem).
# Measured: a user session receives 401 on createRow even with rowSecurity, so
# every write is server-mediated. Distinct from the keys above; never public.
APPWRITE_OPS_API_KEY=
APPWRITE_DEDICATED_PROJECT_CONFIRMED=false
# Functions use Appwrite-injected credentials, not this provisioning key.
APPWRITE_FUNCTIONS_ENABLED=false
# Must remain false until the documented real-cloud transaction suite passes.
APPWRITE_TRANSACTIONS_VERIFIED=false
APPWRITE_REGISTRATION_ENABLED=false
# Production auth remains disabled until shared edge/WAF rate limits are verified.
AUTH_RATE_LIMIT_VERIFIED=false
# Configure only after legal approval; repeat these in the onboarding Function.
NUY_TERMS_VERSION=
NUY_MINIMUM_AGE=
APP_URL=http://localhost:3000

# Isolated Cloud integration suite; never point this at production.
APPWRITE_TEST_API_KEY=
APPWRITE_TEST_ENVIRONMENT=
APPWRITE_RUN_INTEGRATION_TESTS=false
